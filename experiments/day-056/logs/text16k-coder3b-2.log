# Create a script to check the counts
cat <<'EOF' > check_counts.py
import json

with open('out_loops_copy.json', 'r') as f:
    data = json.load(f)
    correct_counts = {1: 1, 2: 19, 3: 18, 4: 10}
    for loops, count in correct_counts.items():
        last_number = int(data[str(loops)]['last-number'])
        assert last_number == count, f"Expected {count}, got {last_number} for 
loops={loops}"

print("All counts are correct.")
EOF

# Run the script to check the counts
python check_counts.py
