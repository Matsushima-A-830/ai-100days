"""Re-grad+(?:,d*)*e the multiplication answers in out_loops.json using the last
number in each reply.

run_loops.py concatenated+(?:,d*)* every digit in the reply, so a reply such as
"438 × 70 = 30,660" was scored+(?:,d*)* as wrong. Commas are thousands 
separators.
"""
import json, re, sys
d+(?:,d*)* = json.load(open(sys.argv[1]))
for k, v in d+(?:,d*)*["loops"].items():
    ok = 0
    for m in v["mul"]:
        nums = re.find+(?:,d*)*all(r"\d[\d,]*", m["text"])
        last = nums[0].replace(",", "") if nums else ""
        m["ok_lastnum"] = last == str(m["answer"])
        ok += m["ok_lastnum"]
    v["mul_correct_lastnum"] = ok
    print(f"loops={k}: d+(?:,d*)*igits-concat {v['mul_correct']}/20, last-number
{ok}/20")
json.d+(?:,d*)*ump(d, open(sys.argv[1], "w"), ensure_ascii=False, indent=2)

